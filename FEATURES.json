  "features": [
    {
      "id": 1,
      "name": "Touch Support para iPad/Tablets",
      "category": "UX/UI",
      "description": "Suporte completo a touch para uso em tablets",
      "status": "implemented",
      "files": ["draw.html", "tutorial.html", "index.html"],
      "changes": [
        "Meta viewport otimizado (maximum-scale=1.0, user-scalable=no)",
        "Removido highlight azul do iOS (-webkit-tap-highlight-color: transparent)",
        "Botões principais: min-height 44px (padrão Apple HIG)",
        "Resize handle: largura aumentada de 8px → 16px",
        "Resize handle com suporte touch (touchstart, touchmove, touchend)",
        "Font-sizes aumentados para melhor legibilidade"
      ],
      "benefits": [
        "Melhor usabilidade em tablets",
        "Sem conflitos de gestos",
        "Feedback visual claro",
        "Cross-platform (desktop + tablet)"
      ]
    },
    {
      "id": 2,
      "name": "Auto-Save (Salvamento Automático)",
      "category": "Data Persistence",
      "description": "Sistema de salvamento automático do progresso",
      "status": "implemented",
      "files": ["draw.html", "tutorial.html"],
      "changes": [
        "Draw: salva workspace + nome do projeto",
        "Tutorial: salva último desafio visitado",
        "Tutorial: salva progresso individual de cada desafio (8 saves separados)",
        "Debouncing: aguarda 1s após última mudança",
        "Indicador visual: '💾 Salvando...' → '💾 Salvo'",
        "LocalStorage como backend",
        "Auto-load ao reabrir"
      ],
      "storage": {
        "draw": {
          "key": "emoji-coder-draw-autosave",
          "data": {
            "state": "Blockly workspace serializado",
            "projectName": "Nome do projeto",
            "timestamp": "Data/hora do save"
          }
        },
        "tutorial": {
          "challengeKey": "emoji-coder-tutorial-challenge",
          "progressKey": "emoji-coder-tutorial-progress-{0-7}",
          "data": {
            "state": "Blockly workspace do desafio",
            "timestamp": "Data/hora do save"
          }
        }
      },
      "benefits": [
        "Sem perda de trabalho ao fechar acidentalmente",
        "Múltiplas sessões (começa em casa, termina na escola)",
        "Cada desafio mantém progresso independente",
        "Feedback visual claro"
      ]
    },
